# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing secret for server-side session tokens.
SESSION_SECRET=

# ADMIN_PASSCODE: Optional server-side passcode for Superadmin access.
ADMIN_PASSCODE=

# MERCADOPAGO_ACCESS_TOKEN: Optional Mercado Pago Access Token for recurring subscriptions.
MERCADOPAGO_ACCESS_TOKEN=

# MERCADOPAGO_WEBHOOK_SECRET: Optional Mercado Pago webhook signature secret.
MERCADOPAGO_WEBHOOK_SECRET=
